# Copy this file to .env and fill in real values.
# Supabase project (Settings > API in the Supabase dashboard)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: exchange rate API. Defaults to Frankfurter (https://frankfurter.dev), which is
# free and needs no key - leave both blank unless you want to use a different provider.
VITE_EXCHANGE_RATE_API_URL=
VITE_EXCHANGE_RATE_API_KEY=
