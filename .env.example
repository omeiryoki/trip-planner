# Copy this file to .env and fill in real values.
# Supabase project (Settings > API in the Supabase dashboard)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Maps Platform (Google Cloud Console > APIs & Services > Credentials)
# Enable: Places API, Directions API, Distance Matrix API, Maps JavaScript API
VITE_GOOGLE_MAPS_API_KEY=

# Google OAuth client for Calendar export (Google Cloud Console > Credentials > OAuth client ID)
# Used only for the separate "export to Google Calendar" consent (calendar.events scope).
# Google sign-in for the app itself is configured on the Supabase Auth provider, not here.
VITE_GOOGLE_CALENDAR_CLIENT_ID=

# Exchange rate API (e.g. https://www.exchangerate-api.com or https://exchangerate.host)
VITE_EXCHANGE_RATE_API_URL=
VITE_EXCHANGE_RATE_API_KEY=
